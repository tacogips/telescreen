# Replace placeholder values before deploying beyond a local development environment.
POSTGRES_PASSWORD=change-me-placeholder
MEILI_MASTER_KEY=replace-me-placeholder

TELESCREEN_DATABASE_URL=postgresql+asyncpg://telescreen:${POSTGRES_PASSWORD}@postgres:5432/telescreen
TELESCREEN_FINGERPRINT_KEY=file:/run/secrets/fingerprint_key
TELESCREEN_POLICE_SIGNING_KEY=file:/run/secrets/police_signing_key
TELESCREEN_POLICE_ENROLLMENT_TOKEN=file:/run/secrets/police_enrollment_token
POLICE_ENROLLMENT_TOKEN=replace-me-placeholder
TELESCREEN_URL=http://bureau:8000
PRIVATE_DB_PATH=/tmp/example-police.db
TELESCREEN_MEILI_URL=http://meilisearch:7700
TELESCREEN_MEILI_API_KEY=env:MEILI_MASTER_KEY
TELESCREEN_POLICE_ALLOW_HTTP=true
TELESCREEN_PUBLIC_BASE_URL=https://bureau.example.invalid

# Optional local-only settings.
TELESCREEN_LOG_LEVEL=INFO
TELESCREEN_WORKER_CONCURRENCY=8
TELESCREEN_WORKER_POLL_SECONDS=1.0
TELESCREEN_EVIDENCE_DIR=/app/var/evidence

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.telescreen.invalid/police/v1/manifest.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^1\\.[0-9]+$"
    },
    "mode": {
      "enum": [
        "pull",
        "push"
      ]
    },
    "task_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(detect|verify_remediation|partition|scan_shard|custom:[a-z0-9_-]{1,64})$"
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]+=[A-Za-z0-9_.:/-]+$"
      }
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "endpoint_url": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "name",
    "version",
    "contract_version",
    "mode",
    "task_types",
    "labels",
    "concurrency"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "push"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "endpoint_url"
        ]
      }
    }
  ]
}

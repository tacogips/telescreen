{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.telescreen.invalid/police/v1/result-envelope.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^1\\.[0-9]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "outcome": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "masked-finding.schema.json"
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "retry_after_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "additionalProperties": false
    },
    "result_token": {
      "type": "string",
      "minLength": 1
    },
    "stats": {
      "type": "object",
      "properties": {
        "resources_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "resources_failed": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_scanned": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "resources_scanned",
        "resources_failed",
        "bytes_scanned"
      ],
      "additionalProperties": false
    },
    "complete_locators": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "required": [
    "contract_version",
    "task_id",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ]
}

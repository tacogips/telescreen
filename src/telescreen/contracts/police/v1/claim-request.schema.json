{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.telescreen.invalid/police/v1/claim-request.schema.json",
  "type": "object",
  "properties": {
    "max_tasks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "wait_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "task_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "max_tasks",
    "wait_seconds"
  ],
  "additionalProperties": false
}
